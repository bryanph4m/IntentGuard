# Every variable here must also exist in the zod schema at apps/control/src/lib/env.ts.
# Adding a variable means updating both files in the same commit.
# Never commit .env.local or real credentials.

# Port the control plane listens on.
CONTROL_PORT=4000

# SQLite file used by the real control API. The parent directory is created by
# the server entrypoint. Use :memory: only in tests.
CONTROL_DB_PATH=data/intentguard.db

# Forge export used when the live Forge request is unavailable.
FORGE_RULES_PATH=forge/rules.json

CONTROL_SNAPSHOT_ID=snap-legacy-refunds-4f1c
CONTROL_CORPUS_VERSION=corpus-1
CONTROL_POLICY_VERSION=policy-1
CONTROL_CANDIDATE_IDS=legacy,A,B,C
CONTROL_BLOCKING_SEVERITY=high
WORKER_POLL_MS=250

NODE_ENV=development
